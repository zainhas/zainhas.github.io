---
layout: default
---
<div class="post">
  <section class="home-hero">
    <div>
      <h1>
        {{ site.first_name }}
        {{ site.last_name }}
      </h1>
      <p class="tagline">{{ page.subtitle }}</p>
      <div class="prose">{{ content }}</div>
      <div class="home-links">
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">LinkedIn</a>
        <a href="https://x.com/{{ site.data.socials.x_username }}">X</a>
        <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
        <span class="contact-hint">{{ site.contact_note }}</span>
      </div>
    </div>

    <div class="home-portrait">
      <pre class="ascii-profile" aria-hidden="true">{% include prof_pic_ascii.txt %}</pre>
      <img class="portrait-mobile" src="{{ 'assets/img/prof_pic_ascii.png' | relative_url }}" alt="Zain Hasan">
    </div>
  </section>

  <div class="section-head">
    <h2>Recent writing</h2>
    <a href="{{ '/writing/' | relative_url }}">All writing &rarr;</a>
  </div>
  {% assign posts = site.data.writing.posts | sort: 'date' | reverse %}
  <ul class="entries">
    {% for post in posts limit: 5 %}
      <li class="entry">
        <span class="entry-date">{{ post.date | date: '%b %Y' }}</span>
        <div class="entry-main">
          <a class="entry-title" href="{{ post.url | relative_url }}">{{ post.title }}</a>
        </div>
        <span class="entry-source">{{ post.source }}</span>
      </li>
    {% endfor %}
  </ul>

  <div class="section-head">
    <h2>Recent talks</h2>
    <a href="{{ '/talks/' | relative_url }}">All talks &rarr;</a>
  </div>
  {% assign talks = site.data.talks.talks | sort: 'date' | reverse %}
  <div class="talk-grid compact">
    {% for talk in talks limit: 3 %}
      {% include talk.liquid talk=talk %}
    {% endfor %}
  </div>
</div>

<script>
  // Reveal the ASCII portrait character by character in random order.
  (function () {
    var pre = document.querySelector('.ascii-profile');
    if (!pre || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var chars = pre.textContent.split('');
    var indices = [];
    for (var i = 0; i < chars.length; i++) {
      if (chars[i] !== ' ' && chars[i] !== '\n') indices.push(i);
    }
    var shown = chars.slice();
    indices.forEach(function (i) {
      shown[i] = ' ';
    });
    pre.textContent = shown.join('');
    for (var k = indices.length - 1; k > 0; k--) {
      var r = Math.floor(Math.random() * (k + 1));
      var tmp = indices[k];
      indices[k] = indices[r];
      indices[r] = tmp;
    }
    var duration = 2500;
    var revealed = 0;
    var start = null;
    function step(ts) {
      if (start === null) start = ts;
      var progress = Math.min((ts - start) / duration, 1);
      var target = Math.floor(progress * indices.length);
      for (; revealed < target; revealed++) shown[indices[revealed]] = chars[indices[revealed]];
      pre.textContent = shown.join('');
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  })();
</script>
